<section id="research-experience" class="home-experience" aria-labelledby="home-experience-heading">
  <h2 id="home-experience-heading">Research Experience</h2>
  <ol class="home-experience-list">
    {% for entry in site.data.home_experience %}
      {% unless entry.home == false %}
      <li class="home-experience-entry">
        <div class="home-experience-header">
          <h3>{{ entry.organization | escape }}</h3>
          <p class="home-experience-date">{{ entry.period | escape }}</p>
        </div>
        <p class="home-experience-role">{{ entry.role | escape }}{% if entry.advisor %} · {{ entry.advisor | escape }}{% endif %}</p>
        <p class="home-experience-summary">{% if entry.topic %}{{ entry.topic | escape }} — {% endif %}{{ entry.summary | escape }}</p>
      </li>
      {% endunless %}
    {% endfor %}
  </ol>
  <a class="experience-link" href="{{ '/experience/' | relative_url }}">View full research experience <span aria-hidden="true">→</span></a>
</section>
