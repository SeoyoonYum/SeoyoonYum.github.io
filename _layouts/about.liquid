---
layout: default
---
<link rel="stylesheet" href="{{ '/assets/css/home-polish.css' | relative_url | bust_file_cache }}">
<div class="post about-page">
  <header class="post-header">
    <h1 class="post-title"><span class="font-weight-bold">{{ site.first_name }}</span> {{ site.last_name }}</h1>
    <p class="home-affiliation"><a href="https://www.kaist.ac.kr/en/">Korea Advanced Institute of Science and Technology</a></p>
  </header>

  <div class="home-intro">
    <figure class="home-portrait">
      <img src="{{ '/assets/img/profile.jpg' | relative_url | bust_file_cache }}" alt="Seoyoon Yum" width="192" height="192" loading="eager">
    </figure>
    <div class="home-bio">
      {{ content }}
      <nav class="home-links" aria-label="Contact and profiles">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
        <span aria-hidden="true">/</span>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
        <span aria-hidden="true">/</span>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        <span aria-hidden="true">/</span>
        <a href="{{ site.data.socials.cv_pdf | relative_url }}">CV</a>
      </nav>
    </div>
  </div>

  <section class="home-publications" aria-labelledby="selected-publications-heading">
    <h2 id="selected-publications-heading">Selected publications</h2>
    <div class="home-featured-papers">
      {% bibliography --group_by none --query @*[selected=true]* --template home-paper %}
    </div>
    <p class="home-all-work"><a href="{{ '/publications/' | relative_url }}">All publications and technical reports →</a></p>
  </section>
</div>
