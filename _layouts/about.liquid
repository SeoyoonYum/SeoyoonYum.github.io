---
layout: academic
---
<div class="post about-page">
  <div class="home-intro">
    <div class="home-bio">
      <header class="post-header">
        <h1 class="post-title">{{ site.first_name }} {{ site.last_name }}</h1>
        <p class="home-affiliation">CS @ KAIST · ML Systems</p>
      </header>
      {{ content }}
      <nav class="home-links" aria-label="Contact and profiles">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
        <span aria-hidden="true">/</span>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
        <span aria-hidden="true">/</span>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        <span aria-hidden="true">/</span>
        <a href="{{ site.data.socials.cv_pdf | relative_url }}">CV</a>
      </nav>
    </div>
    <figure class="home-portrait">
      <img src="{{ '/assets/img/profile.jpg' | relative_url | bust_file_cache }}" alt="Seoyoon Yum" width="180" height="180" loading="eager">
    </figure>
  </div>

  <section class="home-publications" aria-labelledby="publications-heading">
    <h2 id="publications-heading">Publications</h2>
    <div class="home-publication-list">
      {% bibliography --group_by none --query @inproceedings --template home-paper %}
    </div>
    <p class="home-all-work"><a href="{{ '/publications/' | relative_url }}">View publications <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="home-technical-reports" aria-labelledby="technical-reports-heading">
    <h2 id="technical-reports-heading">Technical Report</h2>
    <div class="home-publication-list">
      {% bibliography --group_by none --query @techreport --template home-paper %}
    </div>
    <p class="home-all-work"><a href="{{ '/technical-reports/' | relative_url }}">View technical reports <span aria-hidden="true">→</span></a></p>
  </section>

  {% include home_experience.liquid %}
</div>
