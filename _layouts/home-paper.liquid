---
---
<div class="home-paper">
  <div>
    <h3>{% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">{{ entry.title }}</a>{% elsif entry.html %}<a href="{{ entry.html }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}</h3>
    <p class="home-paper-authors">{% for author in entry.author_array %}{% unless forloop.first %}, {% endunless %}{% if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first %}<strong>{{ author.first }} {{ author.last }}</strong>{% else %}{{ author.first }} {{ author.last }}{% endif %}{% endfor %}</p>
    <p class="home-paper-venue">{% assign venue_lower = entry.abbr | downcase %}{% if venue_lower contains 'neurips' %}<strong>{{ entry.abbr }}</strong>{% else %}{{ entry.abbr }} · {{ entry.year }}{% endif %}</p>
    <div class="home-paper-links">
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}">Paper <span aria-hidden="true">↗</span></a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">Paper <span aria-hidden="true">↗</span></a>
        {% endif %}
      {% endif %}
      {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">DOI <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.code %}<a href="{{ entry.code }}">Code <span aria-hidden="true">↗</span></a>{% endif %}
      {% if entry.key == 'yum2026phasegate' %}<a href="{{ '/research/phasegate/' | relative_url }}">Overview <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
</div>
